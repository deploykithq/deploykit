# ══════════════════════════════════════════════════════════════
#  DeployKit — Development Environment
#  Copy this file to .env and fill in the values.
#
#  Generate secrets:
#    openssl rand -hex 32    (for ENCRYPTION_KEY — 64 hex chars)
#    openssl rand -base64 32 (for JWT secrets)
# ══════════════════════════════════════════════════════════════

# Domain & SSL (production only)
# DOMAIN=panel.yourdomain.com
# ACME_EMAIL=your@email.com

# Database (PostgreSQL)
DB_USER=deploykit
DB_PASSWORD=deploykit_dev
DB_NAME=deploykit
DATABASE_URL=postgresql://deploykit:deploykit_dev@localhost:5432/deploykit

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
# Generate each with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption
# Used to encrypt env vars, source tokens, and SSH keys at rest.
# At least 32 characters; the first 32 bytes are used as the AES-256 key.
# Generate with: openssl rand -hex 32   (64 hex chars)
# WARNING: changing this after data exists makes that data undecryptable.
ENCRYPTION_KEY=

# Webhooks
# Default HMAC secret for verifying GitHub/GitLab webhooks and the generic
# webhook (sent as X-Webhook-Token). Applications may override it with a
# per-app secret. Generate with: openssl rand -base64 32
WEBHOOK_SECRET=

# Ports
API_PORT=3001
WEB_PORT=5173

# Environment: "production" enables HSTS and fails startup on weak secrets
NODE_ENV=development

# Reverse proxy
# Set to "true" ONLY when the API runs behind a trusted proxy (e.g. Traefik)
# that sets X-Forwarded-For. When false, that header is ignored so clients
# cannot spoof their IP to bypass rate limits or poison audit logs.
TRUST_PROXY=false

# CORS
# In production this must match the public URL of your dashboard.
WEB_URL=http://localhost:5173

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Admin Account (optional)
# Pre-create an admin account on first run.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Audit Logs
# Number of days to retain audit log entries (default: 90)
AUDIT_RETENTION_DAYS=90

# Sessions
# Number of days to keep expired/revoked session rows (default: 30)
SESSION_RETENTION_DAYS=30

# Docker (advanced)
# Override the Docker socket path. Auto-detected on most systems.
# DOCKER_SOCKET=/var/run/docker.sock

# Vulnerability scanning (Trivy)
# Scans each built image for known CVEs after build, before deploy. Advisory:
# results are recorded on the deployment but never block it. A per-app toggle
# (application General tab) overrides this default. Local servers only.
SCAN_ENABLED=true
# Trivy runs as an ephemeral container via the Docker CLI. Override to mirror or
# pin a version.
# TRIVY_IMAGE=aquasec/trivy:latest
# Named Docker volume caching Trivy's vulnerability DB (auto-created on first use).
# TRIVY_CACHE_VOLUME=deploykit-trivy-cache
# Per-scan timeout in seconds.
# TRIVY_TIMEOUT_SECONDS=300
